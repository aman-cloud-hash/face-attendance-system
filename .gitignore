# Virtual environment
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & Credentials (NEVER COMMIT SENSITIVE KEYS)
.env
credentials/*.json
!credentials/.gitkeep

# InsightFace downloaded model cache (large binary files)
~/.insightface/
models/*.onnx
models/*.tar.gz
models/*.zip

# Data and logs (preserves empty folder structure via .gitkeep)
data/faces/*
!data/faces/.gitkeep
data/embeddings/*.pkl
data/embeddings/*.json
!data/embeddings/.gitkeep
data/attendance/*.csv
!data/attendance/.gitkeep
*.log
